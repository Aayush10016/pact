# Phase 2 service identity: configure a strong random shared value locally.
CLERK_ISSUER=
AI_SERVICE_KEY=
WORKERS_ENABLED=true
API_ORIGIN=http://127.0.0.1:4000
# Free local storage. R2 remains selectable with EVIDENCE_STORAGE=r2.
EVIDENCE_STORAGE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=pact-evidence
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
PACT_OPERATOR_SUBJECTS=

# Verified Clerk subjects authorized to review cases; never grant from client input.
PACT_REVIEWER_SUBJECTS=
