NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SENTRY_DSN=

# Optional Docker host port overrides (internal service ports stay fixed).
WEB_PORT=3000
API_HOST_PORT=4000
