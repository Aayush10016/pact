AI_ALLOWED_HOSTS=localhost,127.0.0.1,ai
# Phase 2 integrations: intentionally unconfigured, never committed real secrets.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NVIDIA_NIM_API_KEY=
