{
  "name": "pact",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "prepare:packages": "pnpm --filter @pact/types build && pnpm --filter @pact/shared build",
    "dev:web": "pnpm --filter @pact/web dev",
    "dev:api": "pnpm --filter @pact/api dev",
    "build": "pnpm prepare:packages && pnpm --filter @pact/api build && pnpm --filter @pact/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "pnpm encoding:check && pnpm prepare:packages && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "encoding:check": "node scripts/check-encoding.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:bootstrap": "node scripts/bootstrap-local.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "bullmq": "5.65.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "ioredis": "5.8.2",
    "pg": "8.16.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.11"
  }
}
